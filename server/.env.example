# ===========================================
# CCIS PMS — Server Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# Database
DATABASE_URL=postgresql://ccis_admin:ccis_dev_password@localhost:5432/ccis_pms

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Node environment
NODE_ENV=development
